# NotebookLM Configuration
NOTEBOOKLM_URL=https://notebooklm.google.com/notebook/REDACTED

# Mock Mode Configuration
# Set to 'true' to use the mock NotebookLM service for UI testing
MOCK_NOTEBOOKLM=false

# Service Configuration
BACKEND_PORT=8086
FRONTEND_URL=http://localhost:3086

# ── Admin Management ────────────────────────────────────────────────
# Comma-separated list of Google account emails that are allowed to log in as admin
ADMIN_EMAILS=redacted@example.com

# Secret key used to sign admin JWT tokens (use a long random string in production)
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret

# Google OAuth 2.0 credentials (from Google Cloud Console)
# Required for admin login via Google OAuth
# Authorized redirect URI example (local): http://127.0.0.1:8086/api/admin/login/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
