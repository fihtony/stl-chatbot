# NotebookLM Configuration
NOTEBOOKLM_URL=https://notebooklm.google.com/notebook/11223344-5566-7788-99aa-bbccddeeff00

# Mock Mode Configuration
# Set to 'true' to use the mock NotebookLM service for UI testing
# The mock service returns predefined responses based on keywords:
#   - "table" → returns a markdown table
#   - "list" → returns ordered/unordered lists
#   - "format" → returns bold, italic, code text
#   - "image" or "photo" → returns markdown with image
#   - "quote" → returns blockquote
#   - "code" → returns code block
#   - "header" → returns headers (h1-h6)
#   - default → returns plain text response
MOCK_NOTEBOOKLM=false

# Service Configuration
BACKEND_PORT=8086
FRONTEND_URL=http://localhost:3086
