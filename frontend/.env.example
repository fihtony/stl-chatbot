# Backend API URL (必须添加 NEXT_PUBLIC_ 前缀以便前端访问)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8086

# Next.js Configuration
NEXT_PUBLIC_APP_NAME="Collège Saint-Louis Chatbot"

# ============================================================================
# Security Configuration
# ============================================================================
# These settings protect sensitive API routes from unauthorized access.
# Configure these when deploying to production with Cloudflare Tunnel.

# Allowed origins for API requests (comma-separated)
# Example: https://chatbot.collegestlouis.qc.ca,https://*.cloudflareaccess.com
# Leave empty to allow all origins (development only)
ALLOWED_ORIGINS=

# Internal API key for securing sensitive endpoints
# Generate a strong random key (e.g., openssl rand -base64 32)
# Use this key in requests via X-Internal-API-Key header or api_key query param
INTERNAL_API_KEY=
